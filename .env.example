# Copy to .env and fill in real keys. Never commit .env.

# Cesium ion access token (required for 3D tiles / terrain)
# https://cesium.com/ion/tokens
VITE_CESIUM_ION_TOKEN=

# Google Maps / Photorealistic 3D Tiles (optional but recommended)
# https://developers.google.com/maps/documentation/tile
VITE_GOOGLE_MAPS_API_KEY=

# OpenAI (for voice agent / realtime)
# https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# OpenSky Network (aircraft ADS-B)
# https://opensky-network.org/
VITE_OPENSKY_USERNAME=
VITE_OPENSKY_PASSWORD=

# AISStream (ships)
# https://aisstream.io/
VITE_AISSTREAM_API_KEY=

# TomTom traffic (optional)
VITE_TOMTOM_API_KEY=

# Other optional providers — see DATA_SOURCES.md
