# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.js text
*.mjs text
*.cjs text
*.json text
*.md text
*.html text
*.css text
*.xml text
*.yml text
*.yaml text
*.sh text eol=lf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.glb binary
*.gltf binary
*.bin binary
*.jar binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
